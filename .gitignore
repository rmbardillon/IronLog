# Using Android gitignore template: https://github.com/github/gitignore/blob/HEAD/Android.gitignore

# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle & Kotlin build caches
.gradle/
build/
.kotlin/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio & IntelliJ files
*.iml
.idea/
.navigation/
captures/

# Keystore files
#*.jks
#*.keystore

# External native build folder
.externalNativeBuild
.cxx/

# Fastlane & Lint
fastlane/
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/

# Android Profiling
*.hprof
